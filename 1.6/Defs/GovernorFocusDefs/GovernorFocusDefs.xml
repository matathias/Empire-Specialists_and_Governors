<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ==================== Economic ==================== -->
  <FactionColonies.Specialists.GovernorFocusDef>
    <defName>Economic</defName>
    <label>economic development</label>
    <description>The governor focuses on trade and commerce, increasing tithe value and broadly boosting raw material production.</description>
    <baseUpkeepSilver>2</baseUpkeepSilver>
    <skillUpkeepScaling>0.1</skillUpkeepScaling>
    <skillWeights>
      <li><skill>Intellectual</skill><weight>0.4</weight></li>
    </skillWeights>
    <statModifiers>
      <li><stat>titheValueMultiplier</stat><value>0.007143</value></li>
    </statModifiers>
    <resourceBonuses>
      <li><resource>RTD_Food</resource><baseValue>0.003571</baseValue></li>
      <li><resource>RTD_Mining</resource><baseValue>0.003571</baseValue></li>
      <li><resource>RTD_Logging</resource><baseValue>0.003571</baseValue></li>
    </resourceBonuses>
  </FactionColonies.Specialists.GovernorFocusDef>

  <!-- ==================== Military ==================== -->
  <FactionColonies.Specialists.GovernorFocusDef>
    <defName>Military</defName>
    <label>military affairs</label>
    <description>The governor prioritizes martial readiness, improving combat effectiveness and defensive capabilities.</description>
    <baseUpkeepSilver>2</baseUpkeepSilver>
    <skillUpkeepScaling>0.1</skillUpkeepScaling>
    <skillWeights>
      <li><skill>Shooting</skill><weight>0.5</weight></li>
      <li><skill>Melee</skill><weight>0.5</weight></li>
    </skillWeights>
    <statModifiers>
      <li><stat>militaryCombatEfficiency</stat><value>0.005</value></li>
      <li><stat>militaryLevelBonusDefending</stat><value>0.025</value></li>
    </statModifiers>
  </FactionColonies.Specialists.GovernorFocusDef>

  <!-- ==================== Growth ==================== -->
  <FactionColonies.Specialists.GovernorFocusDef>
    <defName>Growth</defName>
    <label>settlement growth</label>
    <description>The governor invests in infrastructure and expansion, accelerating prosperity gain and basic resource output.</description>
    <baseUpkeepSilver>2</baseUpkeepSilver>
    <skillUpkeepScaling>0.1</skillUpkeepScaling>
    <skillWeights>
      <li><skill>Plants</skill><weight>0.4</weight></li>
      <li><skill>Construction</skill><weight>0.4</weight></li>
    </skillWeights>
    <statModifiers>
      <li><stat>prosperityGainedBase</stat><value>0.005</value></li>
    </statModifiers>
    <resourceBonuses>
      <li><resource>RTD_Food</resource><baseValue>0.003</baseValue></li>
      <li><resource>RTD_Logging</resource><baseValue>0.003</baseValue></li>
      <li><resource>RTD_Mining</resource><baseValue>0.003</baseValue></li>
    </resourceBonuses>
  </FactionColonies.Specialists.GovernorFocusDef>

  <!-- ==================== Administrative ==================== -->
  <FactionColonies.Specialists.GovernorFocusDef>
    <defName>Administrative</defName>
    <label>administration</label>
    <description>The governor maintains order and bureaucratic efficiency, reducing unrest and keeping the populace content.</description>
    <baseUpkeepSilver>2</baseUpkeepSilver>
    <skillUpkeepScaling>0.1</skillUpkeepScaling>
    <skillWeights>
      <li><skill>Intellectual</skill><weight>0.6</weight></li>
    </skillWeights>
    <statModifiers>
      <li><stat>happinessLostBase</stat><value>-0.005</value></li>
      <li><stat>unrestGainedMultiplier</stat><value>-0.005</value></li>
    </statModifiers>
  </FactionColonies.Specialists.GovernorFocusDef>

  <!-- ==================== Balanced ==================== -->
  <FactionColonies.Specialists.GovernorFocusDef>
    <defName>Balanced</defName>
    <label>balanced leadership</label>
    <description>The governor takes a measured approach, providing a small but consistent bonus to all settlement production.</description>
    <baseUpkeepSilver>2</baseUpkeepSilver>
    <skillUpkeepScaling>0.1</skillUpkeepScaling>
    <providesBaselineProduction>true</providesBaselineProduction>
    <baselineProductionValue>0.003</baselineProductionValue>
  </FactionColonies.Specialists.GovernorFocusDef>

</Defs>
