  <!-- ==================== Commander ==================== -->
  <FactionColonies.Specialists.SpecialistRoleDef>
    <defName>Commander</defName>
    <label>commander</label>
    <description>A military leader who drills troops and improves the combat effectiveness of the settlement's forces, while also reducing casualties during attacks.</description>
    <maxPerSettlement>2</maxPerSettlement>
    <baseUpkeepSilver>8</baseUpkeepSilver>
    <skillUpkeepScaling>0.4</skillUpkeepScaling>
    <skillWeights>
      <li><skill>Shooting</skill><weight>0.6</weight></li>
      <li><skill>Melee</skill><weight>0.6</weight></li>
    </skillWeights>
    <statModifiers>
      <li><stat>militaryCombatEfficiency</stat><value>0.01</value></li>
      <li><stat>militaryBaseLevel</stat><value>0.05</value></li>
    </statModifiers>
    <modExtensions>
      <li Class="FactionColonies.Specialists.RoleBehaviorExt_Defense">
        <behaviorClass>FactionColonies.Specialists.RoleBehavior_Defense</behaviorClass>
        <baseReductionPerSkillPoint>0.002</baseReductionPerSkillPoint>
        <minimumDeathChance>0.01</minimumDeathChance>
      </li>
    </modExtensions>
  </FactionColonies.Specialists.SpecialistRoleDef>

  <!-- ==================== Quartermaster ==================== -->
  <FactionColonies.Specialists.SpecialistRoleDef>
    <defName>Quartermaster</defName>
    <label>quartermaster</label>
