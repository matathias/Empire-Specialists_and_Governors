    <maxPerSettlement>1</maxPerSettlement>
    <baseUpkeepSilver>6</baseUpkeepSilver>
    <skillUpkeepScaling>0.3</skillUpkeepScaling>
    <skillWeights>
      <li><skill>Social</skill><weight>0.8</weight></li>
      <li><skill>Intellectual</skill><weight>0.4</weight></li>
    </skillWeights>
    <statModifiers>
      <li><stat>titheValueMultiplier</stat><value>0.01</value></li>
    </statModifiers>
  </FactionColonies.Specialists.SpecialistRoleDef>

</Defs>
