<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ==================== Generalist ==================== -->
  <FactionColonies.Specialists.SpecialistRoleDef>
    <defName>Generalist</defName>
    <label>generalist</label>
    <description>A jack-of-all-trades who contributes a small amount to every aspect of settlement production.</description>
    <isGeneralist>true</isGeneralist>
    <providesBaselineProduction>true</providesBaselineProduction>
    <baselineProductionValue>0.02</baselineProductionValue>
    <maxPerSettlement>3</maxPerSettlement>
    <baseUpkeepSilver>2</baseUpkeepSilver>
    <skillUpkeepScaling>0.1</skillUpkeepScaling>
    <skillWeights>
      <li><skill>Shooting</skill><weight>0.08</weight></li>
      <li><skill>Melee</skill><weight>0.08</weight></li>
      <li><skill>Construction</skill><weight>0.08</weight></li>
      <li><skill>Mining</skill><weight>0.08</weight></li>
      <li><skill>Cooking</skill><weight>0.08</weight></li>
      <li><skill>Plants</skill><weight>0.08</weight></li>
      <li><skill>Animals</skill><weight>0.08</weight></li>
      <li><skill>Crafting</skill><weight>0.08</weight></li>
      <li><skill>Artistic</skill><weight>0.08</weight></li>
      <li><skill>Medicine</skill><weight>0.08</weight></li>
      <li><skill>Social</skill><weight>0.08</weight></li>
      <li><skill>Intellectual</skill><weight>0.08</weight></li>
    </skillWeights>
  </FactionColonies.Specialists.SpecialistRoleDef>

  <!-- ==================== Farmer ==================== -->
  <FactionColonies.Specialists.SpecialistRoleDef>
    <defName>Farmer</defName>
    <label>farmer</label>
    <description>A skilled agriculturalist who tends crops and boosts food production at the settlement.</description>
    <maxPerSettlement>3</maxPerSettlement>
    <baseUpkeepSilver>5</baseUpkeepSilver>
    <skillUpkeepScaling>0.3</skillUpkeepScaling>
    <skillWeights>
      <li><skill>Plants</skill><weight>1.0</weight></li>
      <li><skill>Animals</skill><weight>0.3</weight></li>
    </skillWeights>
    <resourceBonuses>
      <li><resource>RTD_Food</resource><baseValue>0.05</baseValue></li>
    </resourceBonuses>
  </FactionColonies.Specialists.SpecialistRoleDef>

