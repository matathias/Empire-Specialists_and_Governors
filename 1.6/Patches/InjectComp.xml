<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Surface settlements -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/FactionColonies.WorldSettlementDef[@Name="WorldSettlementDef_Surface"]/comps</xpath>
    <value>
      <li Class="FactionColonies.Specialists.WorldObjectCompProperties_SettlementSpecialists" />
      <li><compClass>FactionColonies.Specialists.WorldObjectComp_PawnArrival_Resident</compClass></li>
      <li><compClass>FactionColonies.Specialists.WorldObjectComp_PawnArrival_Specialist</compClass></li>
      <li><compClass>FactionColonies.Specialists.WorldObjectComp_PawnArrival_Governor</compClass></li>
    </value>
  </Operation>

  <!-- Orbital settlements (Odyssey DLC, may not be present) -->
  <Operation Class="PatchOperationConditional">
	<xpath>/Defs/FactionColonies.WorldSettlementDef[@Name="WorldSettlementDef_Orbital"]/comps</xpath>
	  <match Class="PatchOperationAdd">
        <xpath>/Defs/FactionColonies.WorldSettlementDef[@Name="WorldSettlementDef_Orbital"]/comps</xpath>
        <value>
          <li Class="FactionColonies.Specialists.WorldObjectCompProperties_SettlementSpecialists" />
          <li><compClass>FactionColonies.Specialists.WorldObjectComp_PawnArrival_Resident</compClass></li>
          <li><compClass>FactionColonies.Specialists.WorldObjectComp_PawnArrival_Specialist</compClass></li>
          <li><compClass>FactionColonies.Specialists.WorldObjectComp_PawnArrival_Governor</compClass></li>
        </value>
     </match>
  </Operation>

</Patch>
