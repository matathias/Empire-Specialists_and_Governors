<?xml version="1.0" encoding="utf-8" ?>
<!--
    Specialists & Governors - Codex Category Definition

    This CodexCategoryDef groups the submod's Codex entries in the in-game Empire
    Codex. Entries are auto-discovered from the DefDatabase and grouped by
    category.modId, so no base-mod changes or registration are needed.

    NOTE: modId must be the package id in ALL LOWERCASE. RimWorld stores
    ModContentPack.PackageId lowercased, and CodexCategoryDef.PackMatchesModId
    compares against it directly. (About/About.xml declares the mixed-case
    "Matathias.Empire.Specialists", but it is stored lowercased at runtime.)
    Mixed case still groups the entries, but the left-pane group header degrades
    to the raw packageId and the preview-image banner fallback stops working.
-->
<Defs>

    <FactionColonies.CodexCategoryDef>
        <defName>CodexCat_Specialists</defName>
        <label>Specialists &amp; Governors</label>
        <description>Sending your own colonists out to settlements as residents, specialists, and governors: the bonuses they grant, what they cost, and the risks they run.</description>
        <color>(0.55, 0.43, 0.78)</color>
        <displayOrder>10</displayOrder>
        <modId>matathias.empire.specialists</modId>
    </FactionColonies.CodexCategoryDef>

</Defs>
